# ===================================================================
# Monta Foam Backend - Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env
# ===================================================================

# --- App ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/monta_foam?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_strong_random_secret_access
JWT_REFRESH_SECRET=replace_with_strong_random_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# --- Google OAuth ---
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# --- OTP ---
OTP_EXPIRES_IN_MINUTES=10
OTP_LENGTH=6

# --- Email (choose Resend OR SMTP) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace_with_resend_api_key
EMAIL_FROM="Monta Foam <no-reply@example.com>"

# SMTP fallback (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_pass

# --- WhatsApp ---
WHATSAPP_ENGINEER_NUMBER=201234567890

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Master Admin Seed (used by prisma/seed.ts) ---
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=ChangeMe123!
MASTER_ADMIN_NAME=Master Admin
